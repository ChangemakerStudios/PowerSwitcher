<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Shared look for PowerSwitcher's dialogs (About, Settings), modelled on Windows 11 Settings.
        Brushes here are light-theme placeholders; ThemedDialogWindow.ApplyTheme() overrides them on each
        window for light, dark and high contrast, so everything below refers to them with DynamicResource.
    -->

    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBackground" Color="#FBFBFB" />
    <SolidColorBrush x:Key="CardBorder" Color="#E5E5E5" />
    <SolidColorBrush x:Key="SubtleFill" Color="#EAEAEA" />
    <SolidColorBrush x:Key="TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="TextSecondary" Color="#5F5F5F" />
    <SolidColorBrush x:Key="Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="AccentText" Color="#0067C0" />
    <SolidColorBrush x:Key="OnAccent" Color="White" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#FDFDFD" />
    <SolidColorBrush x:Key="ButtonBorder" Color="#D0D0D0" />
    <SolidColorBrush x:Key="Critical" Color="#C42B1C" />

