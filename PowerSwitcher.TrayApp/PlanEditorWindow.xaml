<local:ThemedDialogWindow x:Class="PowerSwitcher.TrayApp.PlanEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PowerSwitcher.TrayApp"
        xmlns:vm="clr-namespace:PowerSwitcher.TrayApp.ViewModels"
        Title="Edit power plans"
        Icon="AppIcon.ico"
        Width="1140"
        Height="740"
        MinWidth="1040"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI"
        FontSize="13"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource TextPrimary}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PowerSwitcher.TrayApp;component/Themes/DialogResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="ShowIf" />

            <!-- Type scale, about 1.2 apart: 12 notes, 14 setting names, 16 sections, 20 the plan, 24 the window. -->
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <!-- A filter that's on or off: outlined when off, filled with the accent and ticked when on. -->
            <Style x:Key="FilterChip" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid>
                                <Border x:Name="Chrome" CornerRadius="16" MinHeight="32" Padding="14,0" BorderThickness="1"
                                        Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="Tick" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   Margin="0,1,8,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="FocusRing" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource TextPrimary}" Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PlanList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="ItemContainerStyle">
                    <Setter.Value>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid Margin="0,0,0,2">
                                            <Border x:Name="Bg" CornerRadius="4" Background="Transparent" Padding="12,8">
                                                <ContentPresenter />
                                            </Border>
                                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Background="{DynamicResource Accent}" Visibility="Collapsed" />
                                            <Border x:Name="FocusRing" CornerRadius="4" BorderThickness="2" BorderBrush="{DynamicResource TextPrimary}" Visibility="Collapsed" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFill}" />
                                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFill}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ChoiceTemplate">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
            </DataTemplate>

            <!-- One side of a setting: a number box, a drop-down, or plain text when Windows gives nothing to edit it with. -->
            <DataTemplate x:Key="ValueCellTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Accent}"
                            Visibility="{Binding IsModified, Converter={StaticResource ShowIf}}" ToolTip="{Binding DefaultNote}" />

                    <Grid Grid.Column="1" Visibility="{Binding IsRange, Converter={StaticResource ShowIf}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="82" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox Style="{StaticResource Field}" Text="{Binding Text, Mode=OneWay}"
                                 KeyDown="ValueBox_KeyDown" LostKeyboardFocus="ValueBox_LostKeyboardFocus"
                                 AutomationProperties.Name="{Binding AccessibleName}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Units}" ToolTip="{Binding Units}" FontSize="12"
                                   Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <ComboBox Grid.Column="1" Style="{StaticResource DropDown}" MinWidth="0" ItemTemplate="{StaticResource ChoiceTemplate}"
                              ItemsSource="{Binding Choices}" SelectedItem="{Binding Choice, Mode=OneWay}" Tag="{Binding Display}" ToolTip="{Binding Display}"
                              Visibility="{Binding IsIndex, Converter={StaticResource ShowIf}}"
                              SelectionChanged="ChoiceBox_SelectionChanged" PreviewMouseWheel="ChoiceBox_PreviewMouseWheel"
                              AutomationProperties.Name="{Binding AccessibleName}" />

                    <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Display}" VerticalAlignment="Center"
                               Visibility="{Binding IsReadOnly, Converter={StaticResource ShowIf}}" ToolTip="Windows doesn't say what values this setting accepts, so it can't be edited." />
                </Grid>
            </DataTemplate>

            <!-- More space above a section than below, so its heading reads with the settings it introduces. -->
            <DataTemplate DataType="{x:Type vm:SubgroupHeaderRow}">
                <Grid x:Name="Header" Margin="2,24,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="{DynamicResource AccentText}"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Name, Mode=OneTime}" FontSize="16" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding CountText, Mode=OneTime}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                    </TextBlock>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                        <Setter TargetName="Header" Property="Margin" Value="2,12,0,10" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:SettingRow}">
                <Border Style="{StaticResource Card}" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="188" />
                            <ColumnDefinition Width="188" />
                            <ColumnDefinition Width="60" />
                        </Grid.ColumnDefinitions>

                        <!-- The width cap keeps descriptions to a comfortable line length when the window is maximised. -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="560" Margin="0,0,16,0">
                            <!-- The pill follows a short name, and starts its own line under a long one. -->
                            <WrapPanel>
                                <TextBlock Text="{Binding Name, Mode=OneTime}" TextWrapping="Wrap" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <Border Padding="7,0,7,1" Margin="0,2" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource ButtonBorder}" VerticalAlignment="Center"
                                        Visibility="{Binding IsHidden, Converter={StaticResource ShowIf}}"
                                        ToolTip="Windows hides this setting from its own power options.">
                                    <TextBlock Text="Hidden" FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,3,0,0"
                                       LineHeight="17" LineStackingStrategy="BlockLineHeight" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       Text="{Binding Description}" ToolTip="{Binding Description}"
                                       Visibility="{Binding HasDescription, Converter={StaticResource ShowIf}}" />
                        </StackPanel>

                        <ContentControl Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" IsTabStop="False" Content="{Binding Ac}" ContentTemplate="{StaticResource ValueCellTemplate}" />
                        <ContentControl Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" IsTabStop="False" Content="{Binding Dc}" ContentTemplate="{StaticResource ValueCellTemplate}" />

                        <Button Grid.Column="3" Style="{StaticResource RowAction}" Content="Reset" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Visibility="{Binding CanReset, Converter={StaticResource ShowIf}}" Click="ResetButton_Click"
                                ToolTip="Put this setting back to its default"
                                AutomationProperties.Name="{Binding Name, StringFormat='Reset {0} to default'}" />
                    </Grid>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Edit power plans" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ───────── Plans ───────── -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <UniformGrid Columns="2">
                        <Button x:Name="DuplicateButton" Style="{StaticResource DialogButton}" MinWidth="0" Margin="0,0,3,6" Content="Duplicate" Click="DuplicateButton_Click" />
                        <Button x:Name="RenameButton" Style="{StaticResource DialogButton}" MinWidth="0" Margin="3,0,0,6" Content="Rename" Click="RenameButton_Click" />
                        <Button x:Name="DeleteButton" Style="{StaticResource DialogButton}" MinWidth="0" Margin="0,0,3,0" Content="Delete" Click="DeleteButton_Click" />
                        <Button x:Name="RestoreButton" Style="{StaticResource DialogButton}" MinWidth="0" Margin="3,0,0,0" Content="Restore" Click="RestoreButton_Click"
                                ToolTip="Put this plan back as it was before it was first edited here" />
                    </UniformGrid>

                    <Button x:Name="RestoreDeletedButton" Style="{StaticResource RowAction}" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Content="Restore a deleted plan…" Click="RestoreDeletedButton_Click" />

                    <Border x:Name="ConfirmPanel" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12,10" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="ConfirmText" TextWrapping="Wrap" />
                            <TextBox x:Name="RenameBox" Style="{StaticResource Field}" Margin="0,8,0,0" KeyDown="RenameBox_KeyDown" AutomationProperties.Name="New plan name" />
                            <ComboBox x:Name="DeletedPlanBox" Style="{StaticResource DropDown}" MinWidth="0" Margin="0,8,0,0" DisplayMemberPath="Name" AutomationProperties.Name="Deleted plan to restore" />
                            <UniformGrid Columns="2" Margin="0,10,0,0">
                                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" MinWidth="0" Margin="0,0,3,0" Content="OK" Click="ConfirmButton_Click" />
                                <Button Style="{StaticResource DialogButton}" MinWidth="0" Margin="3,0,0,0" Content="Cancel" Click="CancelButton_Click" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <ListBox x:Name="PlanList" Style="{StaticResource PlanList}" ItemTemplate="{StaticResource PlanTemplate}"
                         SelectionChanged="PlanList_SelectionChanged" AutomationProperties.Name="Power plans" />
            </DockPanel>

            <!-- ───────── Settings ───────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock x:Name="PlanHeading" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PlanNote" Style="{StaticResource Secondary}" Margin="0,2,0,14" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <TextBox x:Name="SearchBox" Style="{StaticResource Field}" Padding="9,6,32,6" TextChanged="Filter_Changed" AutomationProperties.Name="Search settings" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" IsHitTestVisible="False"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock IsHitTestVisible="False" Text="Search settings" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text.Length, ElementName=SearchBox}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <CheckBox Grid.Column="1" x:Name="ChangedToggle" Style="{StaticResource FilterChip}" Margin="12,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed">
                        <TextBlock x:Name="ChangedToggleText" Text="Changed from defaults" />
                    </CheckBox>
                    <CheckBox Grid.Column="2" x:Name="HiddenToggle" Style="{StaticResource FilterChip}" Margin="8,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed">
                        <TextBlock Text="Show hidden settings" />
                    </CheckBox>
                </Grid>

                <!-- The margins line these up with the text inside the cards below: past the card border and padding, the gap and the scrollbar. -->
                <Grid Grid.Row="2" Margin="17,0,37,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="188" />
                        <ColumnDefinition Width="188" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ShownCount" Style="{StaticResource Secondary}" FontSize="12" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="1" Text="Plugged in" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="9,0,0,0" VerticalAlignment="Bottom" />
                    <TextBlock Grid.Column="2" Text="On battery" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="9,0,0,0" VerticalAlignment="Bottom" />
                </Grid>

                <!--
                    Standard (not recycling) virtualization on purpose: a row's controls never get reused for another
                    setting, so a drop-down can't be caught mid-swap and write a value to the wrong setting.
                -->
                <ItemsControl Grid.Row="3" x:Name="SettingsList" Focusable="False"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard" VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScrollBar}" />
                    </ItemsControl.Resources>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsPresenter Margin="0,0,10,0" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>

                <TextBlock Grid.Row="3" x:Name="EmptyText" Style="{StaticResource Secondary}" Text="No settings match." Margin="17,12,0,0" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Close" Margin="8,0,0,0" Click="CloseButton_Click" />
            <Button DockPanel.Dock="Right" x:Name="UndoButton" Style="{StaticResource DialogButton}" Content="Undo" IsEnabled="False" Click="UndoButton_Click" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,0"
                       Text="Changes are saved as you make them. Each plan is backed up before its first change." />
        </DockPanel>
    </Grid>
</local:ThemedDialogWindow>
