<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main, so Velopack's install/update/uninstall hooks run before anything else. -->
    <StartupObject>PowerSwitcher.TrayApp.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="AppIcon.ico" />
    <Resource Include="Tray.ico" />
    <Resource Include="TrayLightTheme.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Petrroll.Helpers\Petrroll.Helpers.csproj" />
    <ProjectReference Include="..\PowerSwitcher\PowerSwitcher.csproj" />
  </ItemGroup>
</Project>
